#!/bin/sh
# The outsource entry point: find or fetch this machine's binary, then exec it.
#
# No binary is committed to git. What IS committed beside this file is
# outsource.sha256 — the release version and the sha256 of each of the four
# release binaries — and this script turns that manifest into a running
# binary, in this order:
#
#   a. bin/outsource-<os>-<arch> — a local build: ./build.sh in a clone, or
#      install.sh with Go. Exec it.
#   b. ${XDG_CACHE_HOME:-$HOME/.cache}/outsource/<version>/outsource-<os>-<arch>
#      — the cache. Every file in it was verified against the manifest (or
#      built from source) at the moment it was written. Exec it.
#   c. Go on PATH plus the source next to the skill (../../../cmd/outsource —
#      true in a marketplace install, which is a copy of the repo): build
#      with build.sh's flags into the cache, then exec.
#   d. Download ${OUTSOURCE_RELEASE_URL:-https://github.com/midagedev/
#      outsource/releases/download}/v<version>/outsource-<os>-<arch> with curl
#      or wget, and run it ONLY if its sha256 equals the manifest's. There is
#      no switch that skips that check: OUTSOURCE_RELEASE_URL changes where
#      bytes come from (a mirror, a test server), never whether they are
#      checked. A mismatch deletes the file and exits 69 naming both hashes.
#   e. Nothing worked: exit 69 with one block naming every attempt and its
#      error, plus how to fix it (Go + ./build.sh, curl/wget, the network).
#
# An os/arch outside the four keeps the old rule: a matching local build runs
# (and (c) may build one under Go's name for it); otherwise exit 69 — there is
# no release asset for it, so there is nothing to verify a download against.
#
# On the paths that exec a binary from OUTSIDE this directory (b, c, d) the
# skill directory is exported as OUTSOURCE_SKILL_DIR, only when unset: code
# that derives the skill dir from its own executable (internal/overlays,
# statusline, quota, cred) would otherwise derive it from the cache and stop
# finding the files that live here. Path (a) needs no export — the binary
# sits in this directory, so the derivation already lands right.
#
# Concurrency: the panel polls every 5 s, the status line and hooks fire on
# their own, so several processes can hit an empty cache at once. The fetch
# (c/d) runs under a mkdir lock in the cache dir; losers wait (bounded) and
# re-check (b), so a download happens once. The winner writes its pid into
# the lock; a waiter breaks the lock at once when that pid is gone (a killed
# fetcher), and a lock with no pid file (an older dispatcher's) after 5
# minutes. A waiter says once on stderr whom it waits for. The cache keeps the
# manifest's version, the most recently used older one, and every version
# fetched or built in the last 7 days — a round launched before an update
# runs its hook from the old version's path (the launcher writes
# os.Executable() into the hook command), and sessions started before an
# update keep calling their own version. Measured 2026-10-20: with 0.21.1,
# 0.21.2 and 0.22.0 sessions alive and only two versions kept, each build
# pruned another version, whose next call rebuilt it and pruned back, and a
# winner killed mid-build left its lock for every caller to wait out
# silently for 120 s.
#
# POSIX sh on purpose: Alpine's busybox sh has no bash. No `readlink -f`
# either: stock macOS lacked it until 12.3. tests/dispatcher.test.sh pins
# the order, the verification, the lock, the pruning, the exported skill dir
# and both refusal shapes.
#
# Exit 69 (EX_UNAVAILABLE): no runnable, verified binary could be produced.
# That code must never leak into a PreToolUse hook, where Claude Code reads
# exit 2 as "block" and any other non-zero as a NON-BLOCKING error — the
# guarded tool would run. build.sh therefore generates git-guard.sh with a
# wrapper translating 69 to 2; the launcher's own hook command names the
# per-arch binary directly and never passes through here.

# Follow a symlink to this file back to the directory the manifest is in.
self=$0
n=0
while [ -h "$self" ] && [ "$n" -lt 40 ]; do
  link=$(readlink "$self") || break
  case $link in
    /*) self=$link ;;
    *) case $self in */*) self=${self%/*}/$link ;; *) self=$link ;; esac ;;
  esac
  n=$((n + 1))
done
case $self in */*) dir=${self%/*} ;; *) dir=. ;; esac

# One fork for both fields. POSIX fixes the output order (sysname first, then machine).
sm=$(uname -s -m 2>/dev/null)
os=${sm%% *}
arch=${sm##* }

# Go's GOOS/GOARCH names, because they are the binaries' names. The first
# case in each list covers the four release targets. The rest lets a binary
# that path (c) built for another machine be found under Go's name for it.
case $os in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) os=$(printf '%s' "$os" | tr '[:upper:]' '[:lower:]') ;;
esac
case $arch in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=amd64 ;;
  armv6l | armv7l) arch=arm ;;
  i386 | i486 | i586 | i686) arch=386 ;;
esac

name=outsource-$os-$arch
bin=$dir/$name

# a. A local build beside this file: the dev/clone path, and install.sh with Go.
if [ -f "$bin" ] && [ -x "$bin" ]; then
  exec "$bin" "$@"
fi

# The committed manifest: the version to cache and fetch under, and the hash
# a download must reproduce. A missing or malformed line means no version —
# and without a version there is no cache path, no build target and nothing
# to verify a download against, so every step below is impossible.
manifest=$dir/outsource.sha256
version=""
want=""
if [ -f "$manifest" ]; then
  version=$(grep -m1 -E '^version [0-9]+\.[0-9]+\.[0-9]+$' "$manifest" | cut -d' ' -f2)
  want=$(grep -E "^[0-9a-f]{64}  $name\$" "$manifest" | head -n 1 | cut -d' ' -f1)
fi

sum_it() {  # hashes $sum_file into $sum_hex — deliberately no positional
  # parameters anywhere in this file: the "never reads its arguments"
  # boundary in tests/shell-boundary.test.sh is a textual one.
  if command -v sha256sum >/dev/null 2>&1; then
    sum_hex=$(sha256sum "$sum_file" | cut -d' ' -f1)
  else
    sum_hex=$(shasum -a 256 "$sum_file" | cut -d' ' -f1)
  fi
}

# export_skill_dir: the dispatcher is the one place that knows where the skill
# lives even when the binary it execs comes from the cache. An explicit
# OUTSOURCE_SKILL_DIR from the caller always wins.
export_skill_dir() {
  if [ -z "${OUTSOURCE_SKILL_DIR:-}" ]; then
    skill=$(cd "$dir/.." 2>/dev/null && pwd) && [ -n "$skill" ] &&
      export OUTSOURCE_SKILL_DIR="$skill"
  fi
}

cache_base=${XDG_CACHE_HOME:-$HOME/.cache}/outsource
why_local="not present ($bin)"

if [ -z "$version" ]; then
  if [ -f "$manifest" ]; then
    why_cache="no 'version X.Y.Z' line in $manifest (broken install)"
  else
    why_cache="no manifest at $manifest (broken install)"
  fi
  version=""
fi

# b. The cache: written only by verified paths below, so presence is enough.
cached=""
if [ -n "$version" ]; then
  cached=$cache_base/$version/$name
  if [ -f "$cached" ] && [ -x "$cached" ]; then
    export_skill_dir
    exec "$cached" "$@"
  fi
  why_cache="not present ($cached)"
fi

fail_69() {  # the everything-failed block, from $why_go and $why_dl
  printf '%s\n' \
"outsource: could not produce a verified binary for ${os:-unknown}/${arch:-unknown}; every path was tried:" \
"  local build   $why_local" \
"  cache         $why_cache" \
"  go build      $why_go" \
"  download      $why_dl" \
"fix: install Go and run ./build.sh in a checkout of the repo (a marketplace copy has the source)," \
"or install curl or wget and check the network, then run this again." >&2
  exit 69
}

if [ -z "$version" ]; then
  why_go="skipped: no version, so no cache path to build into"
  why_dl="skipped: no manifest hash, so a download could not be verified"
  fail_69
fi

verdir=$cache_base/$version
if ! mkdir -p "$verdir" 2>/dev/null || [ ! -d "$verdir" ]; then
  why_cache="cannot create $verdir"
  why_go="skipped: no writable cache to build into"
  why_dl="skipped: no writable cache to download into"
  fail_69
fi

# The fetch lock. Winners hold it across (c) and (d); losers poll (b) and pick
# up the winner's result. A lock older than 5 minutes is a killed fetcher's.
lock=$cache_base/.fetch-lock
locked=0
waited=0
told=0
while [ "$locked" -eq 0 ]; do
  if mkdir "$lock" 2>/dev/null; then
    locked=1
    echo $$ >"$lock/pid"
    break
  fi
  # The winner may have finished between the (b) check and this attempt.
  if [ -n "$cached" ] && [ -f "$cached" ] && [ -x "$cached" ]; then
    break
  fi
  # A holder that wrote its pid and is gone was killed mid-fetch: take over
  # now. A lock with no pid file is an older dispatcher's: every 5th poll,
  # break it once it is over 5 minutes old.
  holder=$(cat "$lock/pid" 2>/dev/null)
  if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
    rm -rf "$lock"
    continue
  fi
  if [ $((waited % 5)) -eq 0 ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +5 2>/dev/null)" ]; then
    rm -rf "$lock"
    continue
  fi
  if [ "$told" -eq 0 ]; then
    printf '%s\n' "outsource: waiting for ${holder:+pid $holder, }another process building or fetching $name into $verdir (up to 120 s)" >&2
    told=1
  fi
  if [ "$waited" -ge 120 ]; then
    break
  fi
  sleep 1
  waited=$((waited + 1))
done

if [ "$locked" -eq 0 ]; then
  # Timed out as a waiter: use (b) if the winner landed it, else report.
  if [ -n "$cached" ] && [ -f "$cached" ] && [ -x "$cached" ]; then
    export_skill_dir
    exec "$cached" "$@"
  fi
  why_go="not tried: another process held the fetch lock for over 120 s"
  why_dl="not tried: another process held the fetch lock for over 120 s"
  fail_69
fi

# Won the lock. A signal now must not leave it behind for every waiter.
trap 'rm -rf "$lock" "$verdir/.tmp.$name.$$"; exit 130' INT TERM HUP

# Re-check (b): a previous winner may have landed it while this
# process was competing for the lock.
if [ -n "$cached" ] && [ -f "$cached" ] && [ -x "$cached" ]; then
  rm -rf "$lock"
  export_skill_dir
  exec "$cached" "$@"
fi

# Prune after a fetch or build lands this version: keep the manifest's
# version and the most recently modified other one (the running-round case in
# the header). Runs under the fetch lock, so two prunes cannot interleave.
prune_cache() {
  keep2=
  for d in "$cache_base"/*/; do
    [ -d "$d" ] || continue
    v=${d%/}; v=${v##*/}
    case $v in *[!0-9.]* | "" | .*) continue ;; esac
    [ "$v" = "$version" ] && continue
    if [ -z "$keep2" ] || [ "$d" -nt "$keep2" ]; then keep2=$d; fi
  done
  for d in "$cache_base"/*/; do
    [ -d "$d" ] || continue
    v=${d%/}; v=${v##*/}
    case $v in *[!0-9.]* | "" | .*) continue ;; esac
    [ "$v" = "$version" ] && continue
    [ "$keep2" = "$d" ] && continue
    [ -z "$(find "${d%/}" -maxdepth 0 -mtime +7 2>/dev/null)" ] && continue
    rm -rf "$d"
  done
}

# c. Go and the source: build with build.sh's exact flags into the cache.
#    Works for any os/arch Go itself can target, the four included.
why_go="not tried yet"
src=$dir/../../../cmd/outsource
if command -v go >/dev/null 2>&1 && [ -d "$src" ]; then
  printf '%s\n' "outsource: no local binary and no cache; building $name from source with go (into the cache)" >&2
  tmp=$verdir/.tmp.$name.$$
  srcroot=$(cd "$dir/../../.." 2>/dev/null && pwd)
  if [ -n "$srcroot" ] &&
     (cd "$srcroot" && CGO_ENABLED=0 GOOS=$os GOARCH=$arch GOTOOLCHAIN=local GOPROXY=off \
        go build -trimpath -buildvcs=false -ldflags='-s -w' -o "$tmp" ./cmd/outsource); then
    chmod 755 "$tmp"
    mv -f "$tmp" "$cached"
    rm -rf "$lock"
    prune_cache
    export_skill_dir
    exec "$cached" "$@"
  fi
  rm -f "$tmp"
  why_go="go build failed for $os/$arch (its output is above, if any)"
elif ! command -v go >/dev/null 2>&1; then
  why_go="go is not on PATH"
else
  why_go="no source beside the skill ($src)"
fi

# d. Download the release asset and run it only if it hashes to the manifest.
#    An os/arch with no manifest line never reaches a download: there would be
#    nothing to verify the bytes against, and unverified bytes never run.
if [ -z "$want" ]; then
  rm -rf "$lock"
  printf '%s\n' "outsource: no binary for ${os:-unknown}/${arch:-unknown} at $bin (shipped: darwin-arm64 darwin-amd64 linux-amd64 linux-arm64) and no release asset to fetch for it; build one for this machine with ./build.sh in a checkout of the repo (needs Go)" >&2
  exit 69
fi

fetcher=""
command -v curl >/dev/null 2>&1 && fetcher=curl
[ -z "$fetcher" ] && command -v wget >/dev/null 2>&1 && fetcher=wget
why_dl="not tried yet"
if [ -z "$fetcher" ]; then
  why_dl="neither curl nor wget is installed"
else
  base=${OUTSOURCE_RELEASE_URL:-https://github.com/midagedev/outsource/releases/download}
  url=${base%/}/v$version/$name
  printf '%s\n' "outsource: downloading $url (it runs only if its sha256 matches bin/outsource.sha256)" >&2
  tmp=$verdir/.tmp.$name.$$
  rm -f "$tmp"
  if [ "$fetcher" = curl ]; then
    curl -fsSL --connect-timeout 15 --max-time 300 -o "$tmp" "$url"
    rc=$?
  else
    wget -q --timeout=15 --tries=2 -O "$tmp" "$url"
    rc=$?
  fi
  if [ "$rc" -ne 0 ] || [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    why_dl="$fetcher failed (rc=$rc) fetching $url"
  else
    sum_file=$tmp
    sum_it
    if [ "$sum_hex" = "$want" ]; then
      chmod 755 "$tmp"
      mv -f "$tmp" "$cached"
      rm -rf "$lock"
      prune_cache
      export_skill_dir
      exec "$cached" "$@"
    fi
    rm -f "$tmp"
    rm -rf "$lock"
    printf '%s\n' \
"outsource: refusing to run $name from $url:" \
"  manifest sha256: $want" \
"  downloaded     : $sum_hex" \
"the file was deleted; nothing unverified was executed." >&2
    exit 69
  fi
fi

rm -rf "$lock"
fail_69
