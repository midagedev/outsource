#!/usr/bin/env bash
# Codex against Cheaper Inference. Key: CHEAPER_INFERENCE_API_KEY (or ~/.codex/cheaperinference.key)
set -euo pipefail
: "${CHEAPER_INFERENCE_API_KEY:=$(cat ~/.codex/cheaperinference.key 2>/dev/null || true)}"
[ -n "$CHEAPER_INFERENCE_API_KEY" ] || { echo "CHEAPER_INFERENCE_API_KEY is unset and ~/.codex/cheaperinference.key does not exist" >&2; exit 1; }
export CHEAPER_INFERENCE_API_KEY
exec codex \
  -c model="${CI_MODEL:-gpt-5.6-terra}" \
  -c model_provider=cheaper-inference \
  -c model_providers.cheaper-inference.name="Cheaper Inference" \
  -c model_providers.cheaper-inference.base_url="https://api.cheaperinference.com/v1" \
  -c model_providers.cheaper-inference.env_key=CHEAPER_INFERENCE_API_KEY \
  -c model_providers.cheaper-inference.wire_api=responses \
  "$@"
